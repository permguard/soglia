table inet soglia { # handle 1
	chain input { # handle 1
		type filter hook input priority filter; policy drop;
		iif "lo" accept # handle 4
		ct state established,related accept # handle 5
		ip saddr 10.201.0.0 ip daddr 10.201.0.1 tcp dport 8080 ct state new accept # handle 6
	}

	chain output { # handle 2
		type filter hook output priority filter; policy drop;
		oif "lo" accept # handle 7
		ct state established,related accept # handle 8
		ip daddr 10.200.255.1 tcp dport 15001 ct state new accept # handle 9
	}

	chain forward { # handle 3
		type filter hook forward priority filter; policy drop;
	}
}
